<%
const translations = {
    ar: {
        title: "تم تغيير كلمة المرور",
        greeting: "مرحباً،",
        message: `تم تغيير كلمة مرور حسابك في ${websiteName} بتاريخ ${date}. إذا أجريت هذا التغيير بنفسك، فلا يلزم اتخاذ أي إجراء.`,
        securityBefore: "إذا لم تُجرِ هذا التغيير، يرجى",
        securityLink: "إعادة تعيين كلمة المرور فورًا",
        contact: "للاستفسار أو طلب المساعدة، تواصل معنا عبر",
        closing: "أطيب التحيات،",
        team: `فريق ${websiteName}`,
    },
    en: {
        title: "Your password was changed",
        greeting: "Hello,",
        message: `Your ${websiteName} account password was changed on ${date}. If you made this change, no action is required.`,
        securityBefore: "If you did not make this change, please",
        securityLink: "reset your password immediately",
        contact: "For questions or assistance, contact us at",
        closing: "Best regards,",
        team: `The ${websiteName} team`,
    },
};
const selectedLanguage = translations[language] ? language : "en";
const content = translations[selectedLanguage];
const direction = selectedLanguage === "ar" ? "rtl" : "ltr";
%>
<!doctype html>
<html lang="<%= selectedLanguage %>" dir="<%= direction %>">
<body style="margin:0; padding:24px; background:#f5f5f5; font-family:Arial,sans-serif; color:#222;">
    <main style="max-width:680px; margin:auto; padding:28px; background:#fff; border:1px solid <%= websiteColor %>; border-radius:8px; line-height:1.8;">
        <header style="text-align:center; color:<%= websiteColor %>;">
            <img src="<%= baseApiImagesUrl %>/images/LogoWithTransparentBackground.webp" alt="<%= websiteName %>" width="100" height="100">
            <h2><%= content.title %></h2>
        </header>
        <p><strong><%= content.greeting %></strong></p>
        <p><%= content.message %></p>
        <p><%= content.securityBefore %> <a href="<%= websiteUrl %>/forget-password" style="color:<%= websiteColor %>;"><%= content.securityLink %></a>.</p>
        <p><%= content.contact %> <a href="mailto:<%= businessEmail %>" style="color:<%= websiteColor %>;"><%= businessEmail %></a>.</p>
        <p><%= content.closing %><br><strong style="color:<%= websiteColor %>;"><%= content.team %></strong></p>
    </main>
</body>
</html>
